<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Текстовое описание -->
    <TextView
        android:id="@+id/instructionText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Press the button to send a message"
        android:textSize="18sp"
        android:layout_marginBottom="16dp" />

    <!-- Кнопка для отправки сообщения немедленно -->
    <Button
        android:id="@+id/button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Send Message Now" />

    <!-- Кнопка для отправки сообщения с задержкой -->
    <Button
        android:id="@+id/buttonDelayed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Send Message with Delay"
        android:layout_marginTop="16dp"/>

</LinearLayout>
